
@model List<Project_MVC_BikeShop.Models.BikeCategory>

@{
    ViewData["Title"] = "Bisiklet Kategorileri";
}

<div class="container mt-4">
    <h2 class="mb-4">Bisiklet Kategorileri</h2>

    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @category.Name
                        </h5>

                        <p class="card-text">
                            @category.Description
                        </p>

                        <a asp-controller="Bike"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="btn btn-primary">
                            Bisikletleri Gör
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
