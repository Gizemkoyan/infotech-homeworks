
@model Project_MVC_MusicShop.Models.Instrument

@{
    ViewData["Title"] = "Enstrüman Düzenle";
}

<h2 class="mb-4">Enstrüman Düzenle</h2>

<form asp-controller="Instrument" asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Enstrüman Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Brand" class="form-label">Marka</label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Fiyat</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="StockQuantity" class="form-label">Stok Miktarı</label>
        <input asp-for="StockQuantity" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="InstrumentCategoryId" class="form-label">Kategori</label>
        <select asp-for="InstrumentCategoryId" class="form-select">
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">Görsel Adresi</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Görsel Önizlemesi</label>
        <div>
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="img-thumbnail"
                 style="max-width: 300px;" />
        </div>
    </div>

    <button type="submit" class="btn btn-success">
        Kaydet
    </button>

    <a asp-controller="Instrument"
       asp-action="Index"
       class="btn btn-secondary">
        İptal
    </a>
</form>
